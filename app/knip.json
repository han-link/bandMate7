{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "tamagui.build.ts"
  ],
  "ignore": [
    "client/**"
  ],
  "ignoreDependencies": [
    "react-native-svg"
  ],
  "babel": {
    "config": [
      "babel.config.js"
    ]
  },
  "expo": {
    "config": [
      "app.json",
      "app.config.{ts,js}"
    ],
    "entry": [
      "app/**/*.{js,jsx,ts,tsx}",
      "**/*.{web,ios,android,native}.{ts,tsx}"
    ]
  }
}
